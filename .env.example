# Copy this file to `.env` and load it (e.g. with `django-environ` or your
# shell/host's env settings) before deploying to production. None of these
# are required for local development/demo — the project has safe defaults.

# --- Core ---
DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# --- Database (leave DJANGO_DB_ENGINE unset to keep using SQLite) ---
DJANGO_DB_ENGINE=mysql
DB_NAME=library_management
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Email (leave DJANGO_EMAIL_BACKEND unset to keep console/dev emails) ---
DJANGO_EMAIL_BACKEND=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Library System <noreply@library-system.local>
